# Copy this file to .env. Never commit the resulting .env file.

# PostgreSQL container bootstrap credentials.
POSTGRES_DB=engineering_worker
POSTGRES_USER=engineering_worker
POSTGRES_PASSWORD=change-me-before-deployment

# Backend database connections inside Docker Compose.
# Keep credentials synchronized with the three POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://engineering_worker:change-me-before-deployment@postgres:5432/engineering_worker
DATABASE_URL_SYNC=postgresql+psycopg://engineering_worker:change-me-before-deployment@postgres:5432/engineering_worker
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_TIMEOUT_SECONDS=30

# Browser-visible API endpoint. "localhost" is correct when opening the UI locally.
PUBLIC_API_URL=http://localhost:8000

# Generate with: openssl rand -hex 32
APP_SECRET_KEY=replace-with-at-least-32-random-characters

# Worker runtime controls. The Compose file mounts its volume at this path.
WORKSPACE_ROOT=/data/workspaces
ARCHIVED_WORKSPACE_RETENTION_DAYS=30
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=1.0
SCHEDULER_MAX_CONCURRENT_JOBS=2
MAX_JOB_TOKENS=120000
MAX_TASK_TOKENS=400000
MAX_JOB_MODEL_CALLS=8
MAX_TASK_MODEL_CALLS=32
MAX_TEAM_TOKENS=0
MAX_JOB_COST_USD=0
MAX_TASK_COST_USD=0
MAX_TEAM_COST_USD=0
WORKER_TIMEOUT_SECONDS=300
DOCKER_API_TIMEOUT_SECONDS=30
WORKER_LEASE_SECONDS=330
WORKER_HEARTBEAT_SECONDS=5
MAX_EXECUTOR_JOBS_PER_TASK=5
MAX_THINKER_JOBS_PER_TASK=3
MAX_SAME_FINDING_REPEATS=2
MAX_CI_REPAIRS_PER_TASK=3
MAX_EXTERNAL_REVIEW_REPAIRS_PER_TASK=3
MAX_JOB_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5
WORKER_TRANSPORT=local

# Server-mode per-job container settings. Local Compose keeps WORKER_TRANSPORT=local.
DOCKER_SOCKET=/var/run/docker.sock
WORKER_CONTAINER_IMAGE=autonomous-engineering-worker-runtime:latest
WORKER_CONTAINER_NETWORK=autonomous-engineering-worker_default
WORKER_WORKSPACE_VOLUME=autonomous-engineering-worker_workspaces
WORKER_CONTAINER_MEMORY_MB=1536
WORKER_CONTAINER_CPUS=1.5
# Optional dedicated least-privilege DB URL for disposable jobs.
# Defaults to DATABASE_URL when blank for local development.
WORKER_DATABASE_URL=
# Optional audited outbound proxy. Enforce bypass prevention at the host firewall.
WORKER_EGRESS_PROXY=
WORKER_NO_PROXY=postgres

# Webhook signing secret configured in the GitHub App/repository webhook.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Platform-owned GitHub App configuration. Users never enter these values in the UI.
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_ID=123456
# Local path to the downloaded PEM. Compose mounts it read-only into the backend.
GITHUB_APP_PRIVATE_KEY_FILE_HOST=./github-app.private-key.pem
# Browser page used after the GitHub installation callback completes.
GITHUB_APP_RETURN_URL=http://localhost:3000/repositories

# Signing secret shown in the Linear webhook configuration.
LINEAR_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Used for safe links from notifications. Telegram bot credentials are configured in Settings
# and encrypted in PostgreSQL using APP_SECRET_KEY.
APPLICATION_BASE_URL=http://localhost:3000
# V2: keep execution flags off until the documented controller/runner smoke tests pass.
# Production same-path mounts/private networks: deploy/compose.v2.yaml.
NEW_FIXED_LIFECYCLE=false
DEVELOPER_HARNESS_CODEX=false
DEVELOPER_HARNESS_CLAUDE=false
LOCAL_EVENT_INTERPRETER=false
REPOSITORY_RAG_ENABLED=false
LEGACY_WORKFLOW_ROUTING=true
LEGACY_EXECUTOR=true
HARNESS_STATE_ROOT=./harness-state
HARNESS_CONTROL_ROOT=./harness-control
DEVELOPER_CONTAINER_IMAGE=engineering-developer:local
DEVELOPER_CONTAINER_NETWORK=engineering-provider-internal
# An approved proxy on an internal Docker network is required for native execution.
DEVELOPER_EGRESS_PROXY=
DEVELOPER_TURN_TIMEOUT_SECONDS=1200
# Zero uses only native automatic compaction. Opt in after SDK verification.
DEVELOPER_COMPACT_BEFORE_FEEDBACK_TOKENS=0
# Administrator-owned argv lists by repository UUID; never model-generated shell strings.
V2_VALIDATION_COMMANDS={}
OLLAMA_BASE_URL=http://ollama:11434
INTERPRETER_MODEL=qwen3:4b
INTERPRETER_TIMEOUT_SECONDS=30
# At most two explicit provider/model entries; requires encrypted credentials and verified prices.
# Empty means no cloud fallback. Never guess model names or price tables.
INTERPRETER_CLOUD_MODELS=[]
INTERPRETER_CLOUD_REQUEST_LIMIT_USD=0.02
SLACK_SIGNING_SECRET=
# workspace-id:channel-id -> team_id, repository_id, comma-separated actor_ids.
SLACK_TEAM_ROUTES={}
TRELLO_WEBHOOK_SECRET=
# Exact externally registered URL, including path, for Trello HMAC verification.
TRELLO_WEBHOOK_CALLBACK_URL=
