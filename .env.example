# Copy this file to .env. Never commit the resulting .env file.

# PostgreSQL container bootstrap credentials.
POSTGRES_DB=engineering_worker
POSTGRES_USER=engineering_worker
POSTGRES_PASSWORD=change-me-before-deployment

# Backend database connections inside Docker Compose.
# Keep credentials synchronized with the three POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://engineering_worker:change-me-before-deployment@postgres:5432/engineering_worker
DATABASE_URL_SYNC=postgresql+psycopg://engineering_worker:change-me-before-deployment@postgres:5432/engineering_worker

# Browser-visible API endpoint. "localhost" is correct when opening the UI locally.
PUBLIC_API_URL=http://localhost:8000

# Generate with: openssl rand -hex 32
APP_SECRET_KEY=replace-with-at-least-32-random-characters

# Worker runtime controls. The Compose file mounts its volume at this path.
WORKSPACE_ROOT=/data/workspaces
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=1.0
WORKER_TIMEOUT_SECONDS=300
WORKER_LEASE_SECONDS=330
