# Public DNS hostname pointing at the server. Do not include a scheme or path.
DOMAIN=worker.example.com
OPERATOR_USER=operator
# Generate using caddy hash-password; keep the hash quoted in your .env file.
OPERATOR_PASSWORD_HASH=

# PostgreSQL bootstrap values. URL-encode reserved characters in the two URLs below.
POSTGRES_DB=engineering_worker
POSTGRES_USER=engineering_worker
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+asyncpg://engineering_worker:replace-with-a-strong-password@postgres:5432/engineering_worker
DATABASE_URL_SYNC=postgresql+psycopg://engineering_worker:replace-with-a-strong-password@postgres:5432/engineering_worker

# Generate independently with: openssl rand -hex 32
APP_SECRET_KEY=replace-with-at-least-32-random-characters
GITHUB_WEBHOOK_SECRET=replace-with-a-different-random-secret
GITHUB_APP_RETURN_URL=https://worker.example.com/integrations
LINEAR_WEBHOOK_SECRET=replace-with-another-random-secret

# Optional worker tuning.
SCHEDULER_POLL_SECONDS=1.0
SCHEDULER_MAX_CONCURRENT_JOBS=2
WORKER_LEASE_SECONDS=330
WORKER_HEARTBEAT_SECONDS=5

# Host directory and local retention for verified database/workspace backup sets.
BACKUP_DIR=./backups
# Explicitly confirm offline consistency when invoking backup/restore tools.
CONFIRM_QUIESCENT=
RESTORE_DATABASE=

# Native execution overlay; do not start workers until PRODUCT_DESCRIPTION.md prerequisites pass.
# Absolute identical host/controller path. Use one application database.
EXECUTION_DATA_ROOT=/srv/engineering
DEVELOPER_CONTAINER_IMAGE=engineering-developer:local
NATIVE_RUNNER_IMAGE=engineering-developer:local
SCHEDULER_ENABLED=false
DEVELOPER_HARNESS_CODEX=true
DEVELOPER_HARNESS_CLAUDE=true
REPOSITORY_VALIDATION_COMMANDS={}
DEVELOPER_COMPACT_BEFORE_FEEDBACK_TOKENS=0
DEVELOPER_TURN_TIMEOUT_SECONDS=1200
DOCKER_API_TIMEOUT_SECONDS=30
LOCAL_EVENT_INTERPRETER=false
INTERPRETER_MODEL=qwen3:4b
INTERPRETER_CLOUD_MODELS=[]
INTERPRETER_CLOUD_REQUEST_LIMIT_USD=0.02
# Supply a verified tag/digest; pre-provision models before enabling local interpretation.
OLLAMA_IMAGE=
OLLAMA_MEMORY_LIMIT=4g
OLLAMA_CPUS=2
SLACK_SIGNING_SECRET=
SLACK_TEAM_ROUTES={}
GITHUB_ISSUE_ROUTES={}
TRELLO_WEBHOOK_SECRET=
TRELLO_WEBHOOK_CALLBACK_URL=
